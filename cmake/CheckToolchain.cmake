file(READ "${PROJECT_SOURCE_DIR}/toolchain.lock.json" QIRB_TOOLCHAIN_LOCK)
string(JSON QIRB_LLVM_VERSION GET "${QIRB_TOOLCHAIN_LOCK}" llvm_project release)
if(NOT LLVM_PACKAGE_VERSION VERSION_EQUAL QIRB_LLVM_VERSION)
  message(FATAL_ERROR
    "qir-mlir requires LLVM/MLIR ${QIRB_LLVM_VERSION}; found LLVM ${LLVM_PACKAGE_VERSION}")
endif()
if(DEFINED MLIR_VERSION AND NOT MLIR_VERSION VERSION_EQUAL QIRB_LLVM_VERSION)
  message(FATAL_ERROR "MLIR ${MLIR_VERSION} does not match the locked LLVM release")
endif()
string(JSON QIRB_LOCK_RTTI GET "${QIRB_TOOLCHAIN_LOCK}" llvm_project rtti)
string(JSON QIRB_LOCK_ASSERTIONS GET "${QIRB_TOOLCHAIN_LOCK}" llvm_project assertions)
if(NOT "${LLVM_ENABLE_RTTI}" STREQUAL "${QIRB_LOCK_RTTI}")
  message(FATAL_ERROR "LLVM RTTI setting must match toolchain.lock.json")
endif()
if(NOT "${LLVM_ENABLE_ASSERTIONS}" STREQUAL "${QIRB_LOCK_ASSERTIONS}")
  message(FATAL_ERROR "LLVM assertions setting must match toolchain.lock.json")
endif()
message(STATUS "QIRBridge scaffold: LLVM/MLIR ${QIRB_LLVM_VERSION}; QIR compatibility unvalidated")
